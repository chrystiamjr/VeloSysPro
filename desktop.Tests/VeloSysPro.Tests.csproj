<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- CodePagesEncodingProvider (OEM code pages) is a package on .NET 8. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile non-WPF domain/services directly; native process execution stays behind a fake. -->
    <Compile Include="..\desktop\ICommandRunner.cs" />
    <Compile Include="..\desktop\IStatusSink.cs" />
    <Compile Include="..\desktop\IpcHandler.cs" />
    <Compile Include="..\desktop\NativeConsoleEncoding.cs" />
    <Compile Include="..\desktop\BackupManager.cs" />
    <Compile Include="..\desktop\Optimizer.cs" />
    <Compile Include="..\desktop\SchedulerManager.cs" />
    <Compile Include="..\desktop\SettingsManager.cs" />
    <Compile Include="..\desktop\SystemActions.cs" />
  </ItemGroup>

</Project>
